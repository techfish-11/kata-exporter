# SwitchBot app: Profile -> Preferences -> App Version (tap 10 times)
KATA_TOKEN=replace_with_your_open_token
KATA_SECRET=replace_with_your_secret

# Optional exporter settings
KATA_DIARY_ENABLED=true
KATA_DIARY_WINDOW=24h

# Optional Prometheus settings
PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION=30d

# Grafana login. Replace the password before starting Compose.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_password
